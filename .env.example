# Set the exact email of the first club administrator. No automatic first-user admin.
ADMIN_EMAIL=
# Stripe secret and signing secret; use test values for staging.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Resend API key and an address on a verified sending domain.
RESEND_API_KEY=
EMAIL_FROM=
# Google OAuth web application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# At least 32 random characters; encrypts Stripe credentials saved in admin settings.
AUTH_SECRET=
